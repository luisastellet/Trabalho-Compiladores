; Teste: Variável não declarada em estrutura complexa
; Esperado: ERRO - variável 'missing_var' não declarada na linha 17

(define square
  (lambda (x)
    (* x x)))

(define apply-op
  (lambda (op a b)
    (cond ((= op 1) (+ a b))
          ((= op 2) (- a b))
          ((= op 3) (* a b))
          (else 0))))

(define combined-result
  (let ((n1 10)
        (n2 20))
    (+ (square n1)
       (apply-op 1 missing_var n2))))
